diff --git a/pynari/Frame.cpp b/pynari/Frame.cpp
index 32b304e..d5dcfd9 100644
--- a/pynari/Frame.cpp
+++ b/pynari/Frame.cpp
@@ -124,6 +124,29 @@ namespace pynari {
       return frame;
     }
 
+    if (channelName == "channel.depth") {
+      uint32_t width, height;
+      ANARIDataType pixelType;
+
+      const void *mapped
+        = anariMapFrame(device->handle,(ANARIFrame)this->handle,
+                        "channel.depth",
+                        &width,&height,&pixelType);
+      if (!mapped || pixelType != ANARI_FLOAT32)
+        throw std::runtime_error("device did not provide a mappable "
+                                 "ANARI_FLOAT32 'channel.depth'");
+      py::object frame
+        = py::array_t<float>(
+                             /* numpy shape */
+                             {(int)height,(int)width},
+                             /*! C strides */
+                             {width*sizeof(float),
+                              sizeof(float)},
+                             (const float*)mapped);
+      anariUnmapFrame(device->handle,(ANARIFrame)handle,"channel.depth");
+      return frame;
+    }
+
     throw std::runtime_error("unsupported channel name '"+channelName
                              +"' in pynari::Frame::get()");
   }
